// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
/*
* ASUS 4G-AC55U
*
* SoC:    Qualcomm Atheros QCA9558 (MIPS 74Kc @ 720MHz), NAND boot
* Switch: Atheros/Qualcomm AR8327(N) - 4x LAN + 1x WAN, built-in 2.4GHz radio
* 5GHz:   QCA988x-family chip on PCIe0 (ath10k "offload" firmware in stock dmesg)
* Modem:  internal Qualcomm-based LTE modem on its own USB bus (05c6:9026, ttyACM)
*
* This file was reconstructed from a stock-firmware dmesg capture, an nvram
* dump, a decoded GPIO table, a live "cat /proc/mtd", a real U-Boot serial
* log, raw dd dumps of mtd0/mtd2/mtd3/mtd4/mtd10, and on-hardware bring-up
* of the ethernet/switch block -- not from a datasheet. NAND partition
* boundaries, the wmac calibration, both MAC addresses, and the AR8327
* switch binding (legacy single-PHY/swconfig, not DSA) are all CONFIRMED
* against that hardware. Everything still under a "NEEDS VERIFICATION"
* comment (LAN/WAN port-to-jack mapping, the switch/WAN/LAN/USB LED wiring,
* the usb0/usb1 label names) remains an open, best-effort guess.
*/

/dts-v1/;

#include "qca955x.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	compatible = "asus,4g-ac55u", "qca,qca9558";
	model = "ASUS 4G-AC55U";
	
	aliases {
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
		/* NEEDS VERIFICATION: confirm eth0 vs eth1 is the "primary" MAC */
		label-mac-device = &eth0;
	};
	
	chosen {
		bootargs = "console=ttyS0,115200";
	};
	
	/*
	* Button GPIOs decoded from gpio_mappings.txt: stock nvram encodes
	* SoC GPIOs as (4096 + pin), active-low.
	*   btn_wps_gpio   = 4112 -> gpio 16
	*   btn_rst_gpio   = 4113 -> gpio 17
	*   btn_wifi_gpio  = 4097 -> gpio 1
	*   btn_lte_gpio   = 4117 -> gpio 21
	*/
	keys {
		compatible = "gpio-keys";
		
		button-wps {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&gpio 16 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
		
		button-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&gpio 17 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
		
		button-wifi {
			label = "wifi";
			linux,code = <KEY_RFKILL>;
			gpios = <&gpio 1 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
		
		button-lte {
			label = "lte";
			linux,code = <BTN_0>;
			gpios = <&gpio 21 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};
	
	/*
	* LED GPIOs, same (4096 + pin) decoding as above:
	*   led_pwr_gpio  = 4114 -> gpio 18 (shared with WPS status in stock fw)
	*   led_lte_gpio  = 4119 -> gpio 23
	*   led_sig1_gpio = 4115 -> gpio 19
	*   led_sig2_gpio = 4116 -> gpio 20
	*   led_sig3_gpio = 4111 -> gpio 15
	*
	* The 2.4G/5G/WAN/LAN/USB indicators are driven differently -- see
	* the "NEEDS VERIFICATION" block further down.
	*/
	leds {
		compatible = "gpio-leds";
		
		led_power: power {
			label = "blue:power";
			gpios = <&gpio 18 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};
		
		led-lte {
			label = "blue:lte";
			gpios = <&gpio 23 GPIO_ACTIVE_LOW>;
		};
		
		led-signal1 {
			label = "blue:signal1";
			gpios = <&gpio 19 GPIO_ACTIVE_LOW>;
		};
		
		led-signal2 {
			label = "blue:signal2";
			gpios = <&gpio 20 GPIO_ACTIVE_LOW>;
		};
		
		led-signal3 {
			label = "blue:signal3";
			gpios = <&gpio 15 GPIO_ACTIVE_LOW>;
		};
		
		/*
		* dmesg from stock firmware shows the "bled" (blink-LED)
		* helper wired directly to plain SoC GPIOs for radio/WAN/USB
		* activity, independent of the nvram led_*_gpio table:
		*   bled: GPIO#14: netdev ath0.            (2.4GHz activity)
		*   bled: GPIO#4:  netdev ath1.             (5GHz activity)
		*   bled: GPIO#22: netdev eth0.             (WAN activity)
		*   bled: GPIO#13: switch ports mask 0.     (LAN activity)
		*   bled: GPIO#12: USB BUS mask 3.          (USB activity)
		* These are used below with netdev/usbport triggers rather
		* than being left as static on/off LEDs.
		*/
		led-wifi2g {
			label = "blue:wifi2g";
			gpios = <&gpio 14 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "phy1tpt";
		};
		
		led-wifi5g {
			label = "blue:wifi5g";
			gpios = <&gpio 4 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "phy0tpt";
		};
		
		led-wan {
			label = "blue:wan";
			gpios = <&gpio 22 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "netdev";
			/* NEEDS VERIFICATION: confirm eth0 really is WAN, see notes */
		};
		
		led-lan {
			label = "blue:lan";
			gpios = <&gpio 13 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "netdev";
			/* NEEDS VERIFICATION: confirm eth1 really is LAN, see notes */
		};
		
		led-usb {
			label = "blue:usb";
			gpios = <&gpio 12 GPIO_ACTIVE_LOW>;
			trigger-sources = <&hub_port0>;
			linux,default-trigger = "usbport";
		};
	};
	
	/*
	* NEEDS VERIFICATION: the nvram led_2g_gpio/led_5g_gpio/led_wan_gpio/
	* led_lan_gpio/led_usb_gpio entries all decode to values >= 12288,
	* which is outside the SoC's 24-line GPIO block entirely. That range
	* is how stock firmware addresses the AR8327's own per-port LED
	* controller, not a SoC GPIO. If the GPIO-based LEDs above don't
	* match what the case silkscreens actually show, the real LEDs are
	* likely switch-driven and belong as "qca,ar8327-leds" child nodes
	* under the switch's PHY node (see &mdio0 below) instead -- that
	* requires confirming the port/channel mapping on the bench first,
	* so it's intentionally left out rather than guessed.
	*/
};

&uart0 {
	status = "okay";
};

/*
* This board boots from NAND, not SPI-NOR (dmesg: "ath79-nand" /
* "AR71xx/AR9xxx Qualcomm-Atheros NAND FLash Controller driver", NAND ID
* 0x92 0xf1, 128MiB, page 2048B / block 128KiB / oob 64B). The onboard SPI-NOR
* (if present at all on this SKU) is not used for boot and is left disabled.
*
* Flash layout reconstructed from dmesg partition table:
*   0x0000000-0x00E0000  "Bootloader"   (MTD_BOOT_PART_SIZE   = 0xe0000)
*   0x00E0000-0x0100000  ASUS config    (MTD_CONFIG_PART_SIZE = 0x20000)
*   0x0100000-0x7F00000  "UBI_DEV"      (126 MiB, UBI: kernel + rootfs volumes)
*   0x7F00000-0x8000000  "caldata"      (1 MiB, last block of NAND)
*/
&nand {
	status = "okay";
	
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;
		
		partition@0 {
			label = "u-boot";
			reg = <0x0000000 0x00e0000>;
			read-only;
		};
		
		partition@e0000 {
			label = "config";
			reg = <0x00e0000 0x0020000>;
			read-only;
		};
		
		partition@100000 {
			label = "ubi";
			reg = <0x0100000 0x7e00000>;
		};
		
		art: partition@7f00000 {
			label = "art";
			reg = <0x7f00000 0x0100000>;
			read-only;
			
			compatible = "nvmem-cells";
			#address-cells = <1>;
			#size-cells = <1>;
			
			/*
			* CONFIRMED against a raw dump of this exact partition
			* (mtd10 "caldata", byte-identical to the UBI "Factory"
			* volume's still-intact copy). Real, structured,
			* calibration-shaped data (repeating per-rate/per-chain
			* power tables) starts exactly at 0x1000 and runs to
			* ~0x1440, matching the common ath79/QCA955x wmac
			* convention this offset/size were originally guessed
			* from -- no longer a guess.
			*/
			cal_art_1000: calibration@1000 {
				reg = <0x1000 0x844>;
			};
			
			/* CONFIRMED: matches et0macaddr from the stock nvram
			* dump byte-for-byte (ac:9e:17:58:99:20). */
			macaddr_art_1002: macaddr@1002 {
				reg = <0x1002 0x6>;
			};
			
			/*
			* CONFIRMED: matches et1macaddr/wl1_hwaddr from nvram
			* (ac:9e:17:58:99:24). Sits at the head of a second
			* calibration-shaped bundle (0x5000-0x5800) that's
			* almost certainly the 5GHz/QCA988x pre-cal data --
			* see the ath10k note under &pcie0 for why that one
			* isn't just wired up as an nvmem-cell here.
			*/
			macaddr_art_5006: macaddr@5006 {
				reg = <0x5006 0x6>;
			};
		};
	};
};

&wmac {
	status = "okay";
	
	nvmem-cells = <&cal_art_1000>;
	nvmem-cell-names = "calibration";
};

/*
* 5GHz radio: QCA988x-family chip on PCIe0 (stock dmesg shows a single
* PCI device at 0000:00:00.0, class 0x0280 network controller; PCIe1
* reported "link is down" so it's left disabled).
*
* CONFIRMED NOT WORKING as of this writing, and the reason is understood:
* this is first-generation "qca988x hw2.0" silicon on old firmware
* (10.2.4-1.0-00047). Board data loads fine (board_file api 1 ...
* crc32 bebc7c08), but OTP calibration fails ("otp calibration failed: 2").
* Feeding it the confirmed pre-cal bundle at art+0x5000 (see
* macaddr_art_5006 above, and the 11-ath10k-caldata hotplug script) gets
* further -- the driver visibly switches into the pre-cal code path --
* but then fails at "failed to get board id: -122". That mechanism was
* added to ath10k for QCA99X0/QCA9888/QCA9984, a later hardware
* generation than this chip; it may simply not be implemented by this
* chip/firmware combination. ath10k-ct's own skip_otp module parameter
* (a documented escape hatch for exactly this, at the cost of running
* uncalibrated) is not exposed in this particular kmod-ath10k-ct build.
* Left enabled below since board data + calibration hotplug are
* legitimate groundwork regardless -- known, understood limitation, not
* a bug to keep chasing without a different firmware build to test.
*/
&pcie0 {
	status = "okay";
};

&pcie1 {
	status = "disabled";
};

/*
* Two independent USB buses match both usb_devices.txt (two root hubs)
* and nvram's "ehci_ports=1-1 2-1": bus 1 is the external USB2.0 port,
* bus 2 goes internally to the soldered-down LTE modem (Qualcomm-based,
* 05c6:9026, exposes ttyACM/QMI -- see usb_path2_* in nvram).
* CONFIRMED against the real qca955x.dtsi: usb0/usb1 and the hub_port0/
* hub_port1 child node names below are correct as-is. Each host
* controller also depends on its own PHY node (usb_phy0/usb_phy1),
* which defaults to status = "disabled" in the SoC dtsi and must be
* enabled separately below -- without this, both controllers sit in
* "deferred probe pending" forever and nothing on either bus enumerates.
*/
&usb_phy0 {
	status = "okay";
};

&usb_phy1 {
	status = "okay";
};

&usb0 {
	status = "okay";
	
	hub_port0: port@1 {
		reg = <1>;
		#trigger-source-cells = <0>;
	};
};

&usb1 {
	status = "okay";
	/* internal, non-removable: the LTE modem lives here */
	
	hub_port1: port@1 {
		reg = <1>;
		#trigger-source-cells = <0>;
	};
};

&mdio0 {
	status = "okay";
	
	/*
	* CONFIRMED working on real hardware. This board's AR8327 needs the
	* legacy single-PHY/swconfig binding, not a DSA ports list -- matches
	* "switch0: Atheros AR8337 rev. 2 switch registered on mdio.0" in the
	* OpenWrt bootlog (that's the legacy driver's own log line). These
	* initvals, and the pll-data on &eth0/&eth1 below, came from a
	* community port of the very similar (non-LTE) ASUS RT-AC55U:
	* https://forum.openwrt.org/t/qca955x-dts-ethernet-phys-porting-openwrt-to-asus-rt-ac55u/104791
	*/
	phy0: ethernet-phy@0 {
		reg = <0>;
		phy-mode = "rgmii-id";
		
		qca,ar8327-initvals = <
		0x04 0x87600000
		0x0c 0x00080080
		0x10 0x81000080
		0x50 0xffb7ffb7
		0x54 0xffb7ffb7
		0x58 0xffb7ffb7
		0x5c 0x03ffff00
		0x7c 0x0000007e
		0x94 0x0000007e
		>;
	};
};

&eth0 {
	status = "okay";
	
	pll-data = <0xa6000000 0x00000101 0x00001616>;
	phy-handle = <&phy0>;
	
	nvmem-cells = <&macaddr_art_1002>;
	nvmem-cell-names = "mac-address";
	
	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

&eth1 {
	status = "okay";
	
	/*
	* nvram: lan_ifnames="eth1 ath0 ath1" -- eth1 is bridged with both
	* radios as the LAN-side MAC, reaching the switch's 2nd (SGMII) CPU
	* port rather than the RGMII port used for WAN on eth0.
	*/
	pll-data = <0x03000101 0x00000101 0x00001616>;
	
	nvmem-cells = <&macaddr_art_5006>;
	nvmem-cell-names = "mac-address";
	
	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

/*
* With the legacy swconfig binding above, per-port LAN/WAN VLAN separation
* is NOT described anywhere in the DTS -- it's entirely a board.d/02_network
* "ucidef_add_switch" job in userspace (dual CPU ports: 0@eth0=WAN,
* 6@eth1=LAN aggregate). CONFIRMED on the bench: switch port 2 = the
* case's "LAN1" jack (a test PC's own MAC address showed up on port 2 in
* `swconfig dev switch0 show`'s ARL table). NEEDS VERIFICATION: ports
* 1/3/4/5 (WAN, LAN2, LAN3, LAN4) are still unconfirmed placeholders --
* same method, one jack at a time.
*/
